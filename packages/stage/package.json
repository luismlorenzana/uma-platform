{
  "name": "@luismlorenzana/uma-stage",
  "version": "0.2.0",
  "description": "The Uma games' HD-2D stage: a three.js world built from 2D kits, pixel sprites, lights and fog, and the kit and design formats (uma-platform ST1, P140). Private; personal use only.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luismlorenzana/uma-platform.git",
    "directory": "packages/stage"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./formats": {
      "import": {
        "types": "./dist/esm/formats/index.d.ts",
        "default": "./dist/esm/formats/index.js"
      },
      "require": {
        "types": "./dist/cjs/formats/index.d.ts",
        "default": "./dist/cjs/formats/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "formats": [
        "./dist/cjs/formats/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "prepack": "pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "review": "node review/build.mjs"
  },
  "peerDependencies": {
    "@luismlorenzana/uma-data": "^1.4.0",
    "@luismlorenzana/uma-kit": ">=0.18.0 <1.0.0",
    "react": "^19.3.0",
    "three": "0.187.0"
  },
  "peerDependenciesMeta": {
    "@luismlorenzana/uma-data": {
      "optional": true
    },
    "@luismlorenzana/uma-kit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@luismlorenzana/uma-data": "workspace:*",
    "@luismlorenzana/uma-kit": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.187.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
