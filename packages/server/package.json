{
  "name": "@luismlorenzana/uma-server",
  "version": "0.2.0",
  "description": "The NestJS pieces both Uma game APIs share: the Firebase auth guard and owner allowlist, the master data release proxy and private packs (uma-platform SD1, SE2). Private; personal use only.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luismlorenzana/uma-platform.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "exports": {
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "auth": [
        "./dist/auth/index.d.ts"
      ],
      "content": [
        "./dist/content/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@nestjs/common": "^11.2.4",
    "@nestjs/core": "^11.2.4",
    "firebase-admin": "^13.10.0",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@nestjs/common": "^11.2.4",
    "@nestjs/core": "^11.2.4",
    "@nestjs/platform-express": "^11.2.4",
    "@types/node": "^22.20.5",
    "firebase-admin": "^13.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
