{
  "name": "@luismlorenzana/uma-kit",
  "version": "0.2.0",
  "description": "The shared app of the Uma games: theme, primitives, shell and Hub map (uma-platform P48). Private; personal use only.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luismlorenzana/uma-platform.git",
    "directory": "packages/kit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "default": "./dist/shell/index.js"
    },
    "./hub": {
      "types": "./dist/hub/index.d.ts",
      "default": "./dist/hub/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/check-dist.mjs",
    "prepack": "pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "motion": "^12.43.0",
    "phaser": "4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.3"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "motion": "^12.43.0",
    "phaser": "4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
