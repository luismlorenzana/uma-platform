{
  "name": "@uma-platform/kit-art",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Original full-colour HD-2D kits drawn by deterministic code (P147): the code is the master → packages/art/kit-*/.",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "draw": "tsx src/export.ts",
    "review": "tsx src/review.ts",
    "review:band": "vite review-band --port 4332 --strictPort",
    "review:kits": "tsx src/review-kits.ts",
    "review:scenes": "vite review-kits --port 4333 --strictPort"
  },
  "devDependencies": {
    "@luismlorenzana/uma-stage": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/three": "0.187.0",
    "three": "0.187.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
