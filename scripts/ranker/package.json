{
  "name": "@uma-platform/ranker-scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Moves the Ranker's files between this Mac and its bucket (RK1, AP16–AP18): seed the local copy from the old boards and imports, push it, pull the live boards and plan back.",
  "type": "module",
  "scripts": {
    "seed": "node --import tsx src/seed.ts",
    "push": "node --import tsx src/push.ts",
    "pull": "node --import tsx src/pull.ts",
    "plan": "node --import tsx src/plan.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@luismlorenzana/uma-data": "workspace:*",
    "@uma-platform/tiers": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
