{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "platform-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@uma-platform/api",
        "dev"
      ],
      "port": 8111
    },
    {
      "name": "platform-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@uma-platform/web",
        "dev"
      ],
      "port": 5204
    },
    {
      "name": "studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "studio"
      ],
      "port": 4318
    },
    {
      "name": "look",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@luismlorenzana/uma-stage",
        "look"
      ],
      "port": 4410
    },
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4401",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs"
      ],
      "port": 4401
    },
    {
      "name": "art-gallery",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "../uma-art-authoring",
        "gallery"
      ],
      "port": 4323
    },
    {
      "name": "art-reviews",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4330",
        "--bind",
        "127.0.0.1",
        "--directory",
        "../uma-art-authoring/content/reviews"
      ],
      "port": 4330
    }
  ]
}
