{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "platform-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@uma-platform/api",
        "dev"
      ],
      "port": 8111
    },
    {
      "name": "platform-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@uma-platform/web",
        "dev"
      ],
      "port": 5204
    },
    {
      "name": "studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "studio"
      ],
      "port": 4318
    },
    {
      "name": "art-gallery",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "art:gallery"
      ],
      "port": 4323
    },
    {
      "name": "story-sandbox",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "../uma-quest/tools/story-sandbox/server.mjs"
      ],
      "port": 4320
    },
    {
      "name": "farm-story-sandbox",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--experimental-strip-types",
        "--no-warnings",
        "../uma-farm/tools/story-sandbox/server.mjs"
      ],
      "port": 4321
    },
    {
      "name": "cyber-story-sandbox",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "../uma-cyberpunk/node_modules/tsx/dist/cli.mjs",
        "../uma-cyberpunk/tools/story-sandbox/server.ts"
      ],
      "port": 4322
    },
    {
      "name": "look",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@luismlorenzana/uma-stage",
        "look"
      ],
      "port": 4410
    }
  ]
}
